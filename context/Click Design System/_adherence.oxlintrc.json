{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "click-app-v2/**",
              "components/app/**",
              "components/core/**",
              "components/forms/**",
              "components/merchant/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Poppins))/i]",
        "message": "Font not provided by the design system. Available: Poppins."
      },
      {
        "selector": "JSXOpeningElement[name.name='AttendeeRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|src|intent|tags|clicked|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<AttendeeRow> doesn't accept that prop. Declared props: name, src, intent, tags, clicked, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|src|size|ring|variant|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, src, size, ring, variant, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:silhouette|initials)$/]",
        "message": "<Avatar> variant must be one of 'silhouette' | 'initials'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Person'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|src|key|ref|className|style|children)$/]",
        "message": "<Person> doesn't accept that prop. Declared props: name, src."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|icon|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|purple|lavender|coral|amber|sage|teal|onImage)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'purple' | 'lavender' | 'coral' | 'amber' | 'sage' | 'teal' | 'onImage'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|full|disabled|loading|iconLeft|iconRight|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, full, disabled, loading, iconLeft, iconRight, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|onPurple|pending|mutual)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'onPurple' | 'pending' | 'mutual'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CapacityMeter'] > JSXAttribute > JSXIdentifier[name!=/^(?:confirmed|cap|maxWidth|style|key|ref|className|style|children)$/]",
        "message": "<CapacityMeter> doesn't accept that prop. Declared props: confirmed, cap, maxWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EventCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|venue|suburb|dist|when|category|categoryLabel|cover|tags|going|goingCount|status|spotsLeft|price|booked|waitlisted|saved|onSave|onCta|onClick|style|key|ref|className|style|children)$/]",
        "message": "<EventCard> doesn't accept that prop. Declared props: name, venue, suburb, dist, when, category, categoryLabel, cover, tags, going, goingCount, status, spotsLeft, price, booked, waitlisted, saved, onSave, onCta, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EventCard'] > JSXAttribute[name.name='category'] > Literal[value!=/^(?:ceramics|run|wine|cooking|music|art|wellness|trivia|outdoors|markets|coffee|workshops)$/]",
        "message": "<EventCard> category must be one of 'ceramics' | 'run' | 'wine' | 'cooking' | 'music' | 'art' | 'wellness' | 'trivia' | 'outdoors' | 'markets' | 'coffee' | 'workshops'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|helper|iconLeft|error|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, helper, iconLeft, error."
      },
      {
        "selector": "JSXOpeningElement[name.name='IntentLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:yourIntent|theirIntent|style|key|ref|className|style|children)$/]",
        "message": "<IntentLine> doesn't accept that prop. Declared props: yourIntent, theirIntent, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|cream|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: size, cream, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MutualCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|src|event|yourIntent|dating|tags|variant|ctaLabel|onCta|onDecline|style|key|ref|className|style|children)$/]",
        "message": "<MutualCard> doesn't accept that prop. Declared props: name, src, event, yourIntent, dating, tags, variant, ctaLabel, onCta, onDecline, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MutualCard'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:preEvent|postEvent)$/]",
        "message": "<MutualCard> variant must be one of 'preEvent' | 'postEvent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PeopleCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|src|intent|sharedEvent|overlap|tags|state|layout|onClick|onView|style|key|ref|className|style|children)$/]",
        "message": "<PeopleCard> doesn't accept that prop. Declared props: name, src, intent, sharedEvent, overlap, tags, state, layout, onClick, onView, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PeopleCard'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|pending|mutual|loading)$/]",
        "message": "<PeopleCard> state must be one of 'default' | 'pending' | 'mutual' | 'loading'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PeopleCard'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:row|stack)$/]",
        "message": "<PeopleCard> layout must be one of 'row' | 'stack'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|note|hero|style|key|ref|className|style|children)$/]",
        "message": "<StatCard> doesn't accept that prop. Declared props: label, value, note, hero, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|style|key|ref|className|style|children)$/]",
        "message": "<StatusPill> doesn't accept that prop. Declared props: status, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|selected|dense|selectable|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, selected, dense, selectable, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|helper|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Toggle> doesn't accept that prop. Declared props: checked, onChange, label, helper, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='WizardStepper'] > JSXAttribute > JSXIdentifier[name!=/^(?:steps|current|onStep|showLabels|style|key|ref|className|style|children)$/]",
        "message": "<WizardStepper> doesn't accept that prop. Declared props: steps, current, onStep, showLabels, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
